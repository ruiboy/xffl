type Query {
  aflSeasons: [AFLSeason!]!
  aflSeason(id: ID!): AFLSeason!
  aflRound(id: ID!): AFLRound
  aflMatch(id: ID!): AFLMatch

  aflClubs: [AFLClub!]!
  aflClub(id: ID!): AFLClub!

  aflPlayerSeason(id: ID!): AFLPlayerSeason

  aflLiveRound: AFLLiveRound
  aflPlayerSearch(query: String!): [AFLPlayer!]!
}

type AFLSeason @key(fields: "id") {
  id: ID!
  name: String!
  ladder: [AFLClubSeason!]!
  rounds: [AFLRound!]!
  playerSeasons(filter: AFLPlayerSeasonFilter, first: Int, after: String): AFLPlayerSeasonConnection!
}

input AFLPlayerSeasonFilter {
  query: String
}

type AFLPlayerSeasonConnection {
  nodes: [AFLPlayerSeason!]!
  pageInfo: PageInfo!
}

type AFLRound @key(fields: "id") {
  id: ID!
  name: String!
  season: AFLSeason!
  matches: [AFLMatch!]!
  byes: [AFLBye!]! @goField(forceResolver: true)
}

type AFLBye {
  id: ID!
  club: AFLClub!
}

type AFLMatch {
  id: ID!
  venue: String
  startTime: String
  result: String
  dataStatus: String!
  round: AFLRound!
  homeClubMatch: AFLClubMatch
  awayClubMatch: AFLClubMatch
}

type AFLClub {
  id: ID!
  name: String!
}

type AFLClubSeason {
  id: ID!
  club: AFLClub!
  season: AFLSeason!
  played: Int!
  won: Int!
  lost: Int!
  drawn: Int!
  for: Int!
  against: Int!
  percentage: Float!
  premiershipPoints: Int!
}

type AFLClubMatch {
  id: ID!
  clubSeasonId: ID!
  club: AFLClub!
  rushedBehinds: Int!
  score: Int!
  playerMatches: [AFLPlayerMatch!]!
  matchId: ID!
  match: AFLMatch
}

type AFLPlayer @key(fields: "id") {
  id: ID!
  name: String!
  latestPlayerSeason: AFLPlayerSeason
}

"""
Aggregation method to apply over a set of matches.
"""
enum AFLStatSummaryMethod {
  MEAN
  MEDIAN
}

"""
Aggregated per-stat values over a set of matches. The same shape is returned
regardless of aggregation method or the entity being aggregated (player season,
club season, …), making it reusable wherever summary stats are needed.
"""
type AFLStatSummary {
  goals:     Float!
  kicks:     Float!
  handballs: Float!
  marks:     Float!
  tackles:   Float!
  hitouts:   Float!
  "Number of matches included in the aggregation."
  games:     Int!
}

type AFLPlayerSeason @key(fields: "id") {
  id: ID!
  player: AFLPlayer!
  clubSeason: AFLClubSeason!
  matches: [AFLPlayerMatch!]!
  """
  Aggregated stats for this player season. Both parameters are optional:
  - upToRoundId: only final matches whose start time is before the earliest
    match in the given round. IDs are treated as opaque — the server resolves
    ordering internally via match start times, never by ID arithmetic.
  - lastN: restrict to the most recent N qualifying matches.
  Combining both gives the last N matches up to a nominated round, useful for
  a rolling form window. Returns null if the player has no qualifying matches.
  """
  stats(upToRoundId: ID, lastN: Int, method: AFLStatSummaryMethod): AFLStatSummary
}

type AFLPlayerMatch @key(fields: "id") {
  id: ID!
  playerSeasonId: ID!
  clubMatchId: ID!
  clubMatch: AFLClubMatch
  player: AFLPlayer!
  status: String!
  kicks: Int!
  handballs: Int!
  marks: Int!
  hitouts: Int!
  tackles: Int!
  goals: Int!
  behinds: Int!
  disposals: Int!
  score: Int!
}

type AFLLiveRound {
  round: AFLRound!
  startDate: String!
}

