type Query {
  fflSeasons: [FFLSeason!]!
  fflSeason(id: ID!): FFLSeason
  fflRound(id: ID!): FFLRound
  fflMatch(id: ID!): FFLMatch

  fflClubs: [FFLClub!]!
  fflClub(id: ID!): FFLClub!
  fflClubSeason(id: ID!): FFLClubSeason

  fflPlayers: [FFLPlayer!]!
  fflPlayer(id: ID!): FFLPlayer!

  fflRoundByAflRound(aflRoundId: ID!): FFLRound
  fflClubMatch(id: ID!): FFLClubMatch

  fflPlayerSeasonsByAflPlayerSeason(aflPlayerSeasonId: ID!): [FFLPlayerSeason!]!
}

type FFLSeason {
  id: ID!
  name: String!
  "The scoring era (rules_id) in effect for this season."
  rulesId: String!
  ladder: [FFLClubSeason!]!
  rounds: [FFLRound!]!
  aflSeason: AFLSeason
}

type FFLRound {
  id: ID!
  name: String!
  aflRoundId: ID
  aflRound: AFLRound
  season: FFLSeason!
  matches: [FFLMatch!]!
}

type FFLMatch {
  id: ID!
  venue: String
  startTime: String
  result: String
  round: FFLRound!
  "Convenience sugar over clubMatches: the home side of a versus match (null otherwise)."
  homeClubMatch: FFLClubMatch
  "Convenience sugar over clubMatches: the away side of a versus match (null otherwise)."
  awayClubMatch: FFLClubMatch
  "'versus', 'bye', or 'superbye'."
  matchStyle: String!
  "The canonical list of every club_match in this match, each tagged with its side. Home/away are sugar over this."
  clubMatches: [FFLClubMatch!]!
}

type FFLClub {
  id: ID!
  name: String!
}

type FFLClubSeason {
  id: ID!
  club: FFLClub!
  season: FFLSeason!
  played: Int!
  won: Int!
  lost: Int!
  drawn: Int!
  for: Int!
  against: Int!
  percentage: Float!
  premiershipPoints: Int!
  "Extra points earned eg from superbyes"
  extraPoints: Int!
  players(first: Int, after: String, filter: FFLPlayerSeasonFilter): FFLPlayerSeasonConnection!
}

type FFLClubMatch {
  id: ID!
  clubSeasonId: ID!
  "This club_match's role in its match: 'home' | 'away' | 'bye' | 'superbye'."
  side: String!
  roundId: ID
  aflRoundId: ID
  seasonId: ID
  club: FFLClub!
  dataStatus: String!
  notes: String
  score: Int!
  playerMatches: [FFLPlayerMatch!]!
  suggestedSubstitutions: [FFLSuggestedSubstitution!]!
}

enum FFLSubstitutionKind {
  interchange
  sub
}

type FFLSuggestedSubstitution {
  kind: FFLSubstitutionKind!
  replacedPmId: ID!
  replacingPmId: ID!
}

type FFLPlayer {
  id: ID!
  aflPlayerId: ID!
  aflPlayer: AFLPlayer!
}

type FFLPlayerSeason {
  id: ID!
  player: FFLPlayer!
  club: FFLClub!
  clubSeasonId: ID!
  aflPlayerSeasonId: ID
  aflPlayerSeason: AFLPlayerSeason
  fromRoundId: ID
  toRoundId: ID
  notes: String
  costCents: Int
  playerMatches: [FFLPlayerMatch!]!
}

type FFLPlayerSeasonConnection {
  nodes: [FFLPlayerSeason!]!
  pageInfo: PageInfo!
}

input FFLPlayerSeasonFilter {
  "Not supported"
  active: Boolean
}

enum FFLPlayerMatchStatus {
  named
  subbed_out
  subbed_in
  interchanged_out
  interchanged_in
}

enum FFLAFLPlayerMatchStatus {
  named
  playing
  played
  dnp
  bye
}

type FFLPlayerMatch {
  id: ID!
  playerSeasonId: ID!
  playerSeason: FFLPlayerSeason!
  player: FFLPlayer!
  matchId: ID
  position: String
  status: FFLPlayerMatchStatus
  aflStatus: FFLAFLPlayerMatchStatus
  backupPositions: String
  interchangePosition: String
  displayOrder: Int!
  notes: String
  score: Int!
  aflPlayerMatchId: ID
  aflPlayerMatch: AFLPlayerMatch
}

# --- Stub types owned by the AFL subgraph — resolved via federation. ---

type AFLSeason @key(fields: "id") {
  id: ID!
}

type AFLRound @key(fields: "id") {
  id: ID!
}

type AFLPlayer @key(fields: "id") {
  id: ID!
}

type AFLPlayerSeason @key(fields: "id") {
  id: ID!
  fflPlayerSeasons: [FFLPlayerSeason!]!
}

type AFLPlayerMatch @key(fields: "id") {
  id: ID!
}


